# Copy to .env (git-ignored) and fill in real values. Used by docker-compose.yml.

# Host port where NGINX publishes the app: http://localhost:8085
APP_PORT=8085

# PostgreSQL of the host machine (the database must exist; Flyway creates the schema).
DB_URL=jdbc:postgresql://host.docker.internal:5432/accountant
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Base64 secret of at least 256 bits. Generate one, e.g.:
#   openssl rand -base64 32
JWT_SECRET=change-me-with-a-base64-256-bit-secret
JWT_EXPIRATION_MINUTES=240
