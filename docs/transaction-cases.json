{
  "version": 1,
  "description": "Shared test cases of the transaction engine (backend Java and frontend TypeScript). Amounts are strings with 2 decimals. Defaults: account status ACTIVE, temporary false, creditLimit null; transaction fee 0.00, applied true, operationDate 2026-10-01T12:00:00, destination null. Each case expects either 'expected' (accounts and transactions to check, matched by id / uuid) or 'error' (first failing transaction; field/fieldCode only for VALIDATION_ERROR).",
  "cases": [
    {
      "name": "INCOME adds amount minus fee to the storage and is reported as income",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 3, "type": "SUPPLIER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "INCOME", "origin": 3, "destination": 1, "amount": "1000.00", "fee": "50.00" }
      ],
      "expected": {
        "accounts": [{ "id": 1, "balance": "1950.00", "pendingExpense": null, "status": "ACTIVE" }],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "ADDITION",
            "reportedAmount": "950.00",
            "originBalanceBefore": null,
            "originBalanceAfter": null,
            "destinationBalanceBefore": "1000.00",
            "destinationBalanceAfter": "1950.00"
          }
        ]
      }
    },
    {
      "name": "INCOME fee must be lower than the amount",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "0.00" },
        { "id": 3, "type": "SUPPLIER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "INCOME", "origin": 3, "destination": 1, "amount": "100.00", "fee": "100.00" }
      ],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "fee", "fieldCode": "FEE_NOT_BELOW_AMOUNT" }
    },
    {
      "name": "INCOME cannot be pending",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "0.00" },
        { "id": 3, "type": "SUPPLIER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "INCOME", "origin": 3, "destination": 1, "amount": "100.00", "applied": false }
      ],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "applied", "fieldCode": "PENDING_NOT_ALLOWED" }
    },
    {
      "name": "INCOME origin must be a SUPPLIER",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "100.00" },
        { "id": 2, "type": "STORAGE", "balance": "0.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "INCOME", "origin": 2, "destination": 1, "amount": "10.00" }],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "originAccountId", "fieldCode": "ORIGIN_NOT_ALLOWED" }
    },
    {
      "name": "A GROUP never participates in transactions",
      "accounts": [
        { "id": 3, "type": "SUPPLIER" },
        { "id": 11, "type": "GROUP" }
      ],
      "transactions": [{ "uuid": "t1", "type": "INCOME", "origin": 3, "destination": 11, "amount": "10.00" }],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "destinationAccountId", "fieldCode": "DESTINATION_NOT_ALLOWED" }
    },
    {
      "name": "EXPENSE from STORAGE subtracts amount plus fee and reports it as expense",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 4, "type": "CONSUMER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "EXPENSE", "origin": 1, "destination": 4, "amount": "200.00", "fee": "10.00" }
      ],
      "expected": {
        "accounts": [{ "id": 1, "balance": "790.00", "pendingExpense": null, "status": "ACTIVE" }],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "SUBTRACTION",
            "reportedAmount": "210.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "790.00",
            "destinationBalanceBefore": null,
            "destinationBalanceAfter": null
          }
        ]
      }
    },
    {
      "name": "EXPENSE from STORAGE without enough funds",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "100.00" },
        { "id": 4, "type": "CONSUMER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "EXPENSE", "origin": 1, "destination": 4, "amount": "100.00", "fee": "1.00" }
      ],
      "error": { "code": "INSUFFICIENT_FUNDS", "transactionUuid": "t1" }
    },
    {
      "name": "Pending EXPENSE from STORAGE does not touch the balance yet",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 4, "type": "CONSUMER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "EXPENSE", "origin": 1, "destination": 4, "amount": "300.00", "applied": false }
      ],
      "expected": {
        "accounts": [{ "id": 1, "balance": "1000.00", "pendingExpense": null, "status": "ACTIVE" }],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "SUBTRACTION",
            "reportedAmount": "300.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "1000.00",
            "destinationBalanceBefore": null,
            "destinationBalanceAfter": null
          }
        ]
      }
    },
    {
      "name": "EXPENSE from DEBTOR (card purchase) grows the debt and the expense to recognize, not an expense yet",
      "accounts": [
        { "id": 5, "type": "DEBTOR", "balance": "0.00", "pendingExpense": "0.00", "creditLimit": "5000.00" },
        { "id": 4, "type": "CONSUMER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "EXPENSE", "origin": 5, "destination": 4, "amount": "1200.00", "fee": "5.00" }
      ],
      "expected": {
        "accounts": [{ "id": 5, "balance": "1205.00", "pendingExpense": "1205.00", "status": "ACTIVE" }],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "0.00",
            "originBalanceAfter": "1205.00",
            "destinationBalanceBefore": null,
            "destinationBalanceAfter": null
          }
        ]
      }
    },
    {
      "name": "EXPENSE from DEBTOR cannot exceed the credit limit",
      "accounts": [
        { "id": 5, "type": "DEBTOR", "balance": "4900.00", "pendingExpense": "4900.00", "creditLimit": "5000.00" },
        { "id": 4, "type": "CONSUMER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "EXPENSE", "origin": 5, "destination": 4, "amount": "100.00", "fee": "1.00" }
      ],
      "error": { "code": "CREDIT_LIMIT_EXCEEDED", "transactionUuid": "t1" }
    },
    {
      "name": "EXPENSE from a DEBTOR without credit line has no limit",
      "accounts": [
        { "id": 9, "type": "DEBTOR", "balance": "1000.00", "pendingExpense": "400.00" },
        { "id": 4, "type": "CONSUMER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "EXPENSE", "origin": 9, "destination": 4, "amount": "1000000.00" }
      ],
      "expected": {
        "accounts": [{ "id": 9, "balance": "1001000.00", "pendingExpense": "1000400.00", "status": "ACTIVE" }],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "1001000.00",
            "destinationBalanceBefore": null,
            "destinationBalanceAfter": null
          }
        ]
      }
    },
    {
      "name": "Pending EXPENSE from DEBTOR does not grow the debt yet",
      "accounts": [
        { "id": 5, "type": "DEBTOR", "balance": "0.00", "pendingExpense": "0.00", "creditLimit": "5000.00" },
        { "id": 4, "type": "CONSUMER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "EXPENSE", "origin": 5, "destination": 4, "amount": "500.00", "applied": false }
      ],
      "expected": {
        "accounts": [{ "id": 5, "balance": "0.00", "pendingExpense": "0.00", "status": "ACTIVE" }],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "0.00",
            "originBalanceAfter": "0.00",
            "destinationBalanceBefore": null,
            "destinationBalanceAfter": null
          }
        ]
      }
    },
    {
      "name": "EXPENSE destination must be a CONSUMER",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 2, "type": "STORAGE", "balance": "0.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "EXPENSE", "origin": 1, "destination": 2, "amount": "10.00" }],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "destinationAccountId", "fieldCode": "DESTINATION_NOT_ALLOWED" }
    },
    {
      "name": "TRANSFER moves A immediately and credits A minus fee",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 2, "type": "STORAGE", "balance": "500.00" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "TRANSFER", "origin": 1, "destination": 2, "amount": "300.00", "fee": "5.00" }
      ],
      "expected": {
        "accounts": [
          { "id": 1, "balance": "700.00", "pendingExpense": null, "status": "ACTIVE" },
          { "id": 2, "balance": "795.00", "pendingExpense": null, "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "700.00",
            "destinationBalanceBefore": "500.00",
            "destinationBalanceAfter": "795.00"
          }
        ]
      }
    },
    {
      "name": "Pending TRANSFER: money leaves the origin, the destination is credited when applied",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 2, "type": "STORAGE", "balance": "500.00" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "TRANSFER", "origin": 1, "destination": 2, "amount": "300.00", "applied": false }
      ],
      "expected": {
        "accounts": [
          { "id": 1, "balance": "700.00", "pendingExpense": null, "status": "ACTIVE" },
          { "id": 2, "balance": "500.00", "pendingExpense": null, "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "700.00",
            "destinationBalanceBefore": "500.00",
            "destinationBalanceAfter": "500.00"
          }
        ]
      }
    },
    {
      "name": "TRANSFER without enough funds",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "100.00" },
        { "id": 2, "type": "STORAGE", "balance": "0.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "TRANSFER", "origin": 1, "destination": 2, "amount": "150.00" }],
      "error": { "code": "INSUFFICIENT_FUNDS", "transactionUuid": "t1" }
    },
    {
      "name": "TRANSFER requires a destination",
      "accounts": [{ "id": 1, "type": "STORAGE", "balance": "100.00" }],
      "transactions": [{ "uuid": "t1", "type": "TRANSFER", "origin": 1, "amount": "10.00" }],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "destinationAccountId", "fieldCode": "DESTINATION_REQUIRED" }
    },
    {
      "name": "Origin and destination must be different",
      "accounts": [{ "id": 1, "type": "STORAGE", "balance": "100.00" }],
      "transactions": [{ "uuid": "t1", "type": "TRANSFER", "origin": 1, "destination": 1, "amount": "10.00" }],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "destinationAccountId", "fieldCode": "SAME_ACCOUNT" }
    },
    {
      "name": "INVEST from STORAGE to INVESTMENT",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 6, "type": "INVESTMENT", "balance": "2000.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "INVEST", "origin": 1, "destination": 6, "amount": "1000.00" }],
      "expected": {
        "accounts": [
          { "id": 1, "balance": "0.00", "pendingExpense": null, "status": "ACTIVE" },
          { "id": 6, "balance": "3000.00", "pendingExpense": null, "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "0.00",
            "destinationBalanceBefore": "2000.00",
            "destinationBalanceAfter": "3000.00"
          }
        ]
      }
    },
    {
      "name": "INVEST from INVESTMENT to BUSINESS",
      "accounts": [
        { "id": 6, "type": "INVESTMENT", "balance": "2000.00" },
        { "id": 7, "type": "BUSINESS", "balance": "1000.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "INVEST", "origin": 6, "destination": 7, "amount": "500.00" }],
      "expected": {
        "accounts": [
          { "id": 6, "balance": "1500.00", "pendingExpense": null, "status": "ACTIVE" },
          { "id": 7, "balance": "1500.00", "pendingExpense": null, "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "2000.00",
            "originBalanceAfter": "1500.00",
            "destinationBalanceBefore": "1000.00",
            "destinationBalanceAfter": "1500.00"
          }
        ]
      }
    },
    {
      "name": "INVEST fee must be lower than the amount",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 6, "type": "INVESTMENT", "balance": "0.00" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "INVEST", "origin": 1, "destination": 6, "amount": "100.00", "fee": "100.00" }
      ],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "fee", "fieldCode": "FEE_NOT_BELOW_AMOUNT" }
    },
    {
      "name": "PROFIT from BUSINESS to STORAGE with fee",
      "accounts": [
        { "id": 7, "type": "BUSINESS", "balance": "1000.00" },
        { "id": 1, "type": "STORAGE", "balance": "1000.00" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "PROFIT", "origin": 7, "destination": 1, "amount": "400.00", "fee": "40.00" }
      ],
      "expected": {
        "accounts": [
          { "id": 7, "balance": "600.00", "pendingExpense": null, "status": "ACTIVE" },
          { "id": 1, "balance": "1360.00", "pendingExpense": null, "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "600.00",
            "destinationBalanceBefore": "1000.00",
            "destinationBalanceAfter": "1360.00"
          }
        ]
      }
    },
    {
      "name": "PROFIT from a temporary INVESTMENT disables it, even with remaining balance",
      "accounts": [
        { "id": 10, "type": "INVESTMENT", "balance": "800.00", "temporary": true },
        { "id": 1, "type": "STORAGE", "balance": "1000.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "PROFIT", "origin": 10, "destination": 1, "amount": "500.00" }],
      "expected": {
        "accounts": [
          { "id": 10, "balance": "300.00", "pendingExpense": null, "status": "DISABLED" },
          { "id": 1, "balance": "1500.00", "pendingExpense": null, "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "800.00",
            "originBalanceAfter": "300.00",
            "destinationBalanceBefore": "1000.00",
            "destinationBalanceAfter": "1500.00"
          }
        ]
      }
    },
    {
      "name": "A temporary account disabled by its PROFIT cannot be used later in the same batch",
      "accounts": [
        { "id": 10, "type": "INVESTMENT", "balance": "800.00", "temporary": true },
        { "id": 1, "type": "STORAGE", "balance": "1000.00" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "PROFIT", "origin": 10, "destination": 1, "amount": "800.00", "operationDate": "2026-10-01T12:00:00" },
        { "uuid": "t2", "type": "INVEST", "origin": 1, "destination": 10, "amount": "100.00", "operationDate": "2026-10-02T12:00:00" }
      ],
      "error": { "code": "ACCOUNT_DISABLED", "transactionUuid": "t2" }
    },
    {
      "name": "Pending PROFIT of a temporary account disables it and leaves the destination untouched",
      "accounts": [
        { "id": 10, "type": "INVESTMENT", "balance": "800.00", "temporary": true },
        { "id": 1, "type": "STORAGE", "balance": "1000.00" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "PROFIT", "origin": 10, "destination": 1, "amount": "800.00", "applied": false }
      ],
      "expected": {
        "accounts": [
          { "id": 10, "balance": "0.00", "pendingExpense": null, "status": "DISABLED" },
          { "id": 1, "balance": "1000.00", "pendingExpense": null, "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "800.00",
            "originBalanceAfter": "0.00",
            "destinationBalanceBefore": "1000.00",
            "destinationBalanceAfter": "1000.00"
          }
        ]
      }
    },
    {
      "name": "DIVIDEND without destination credits the origin",
      "accounts": [{ "id": 6, "type": "INVESTMENT", "balance": "2000.00" }],
      "transactions": [{ "uuid": "t1", "type": "DIVIDEND", "origin": 6, "amount": "100.00", "fee": "10.00" }],
      "expected": {
        "accounts": [{ "id": 6, "balance": "2090.00", "pendingExpense": null, "status": "ACTIVE" }],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "ADDITION",
            "reportedAmount": "90.00",
            "originBalanceBefore": "2000.00",
            "originBalanceAfter": "2090.00",
            "destinationBalanceBefore": null,
            "destinationBalanceAfter": null
          }
        ]
      }
    },
    {
      "name": "DIVIDEND with destination credits the destination only",
      "accounts": [
        { "id": 8, "type": "CREDITOR", "balance": "300.00" },
        { "id": 1, "type": "STORAGE", "balance": "1000.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "DIVIDEND", "origin": 8, "destination": 1, "amount": "50.00" }],
      "expected": {
        "accounts": [
          { "id": 8, "balance": "300.00", "pendingExpense": null, "status": "ACTIVE" },
          { "id": 1, "balance": "1050.00", "pendingExpense": null, "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "ADDITION",
            "reportedAmount": "50.00",
            "originBalanceBefore": "300.00",
            "originBalanceAfter": "300.00",
            "destinationBalanceBefore": "1000.00",
            "destinationBalanceAfter": "1050.00"
          }
        ]
      }
    },
    {
      "name": "DIVIDEND fee must be lower than the amount",
      "accounts": [{ "id": 6, "type": "INVESTMENT", "balance": "0.00" }],
      "transactions": [{ "uuid": "t1", "type": "DIVIDEND", "origin": 6, "amount": "10.00", "fee": "12.00" }],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "fee", "fieldCode": "FEE_NOT_BELOW_AMOUNT" }
    },
    {
      "name": "INTEREST on STORAGE is an expense",
      "accounts": [{ "id": 1, "type": "STORAGE", "balance": "1000.00" }],
      "transactions": [{ "uuid": "t1", "type": "INTEREST", "origin": 1, "amount": "15.00" }],
      "expected": {
        "accounts": [{ "id": 1, "balance": "985.00", "pendingExpense": null, "status": "ACTIVE" }],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "SUBTRACTION",
            "reportedAmount": "15.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "985.00",
            "destinationBalanceBefore": null,
            "destinationBalanceAfter": null
          }
        ]
      }
    },
    {
      "name": "INTEREST on DEBTOR grows the debt and the expense to recognize",
      "accounts": [{ "id": 5, "type": "DEBTOR", "balance": "1000.00", "pendingExpense": "1000.00", "creditLimit": "5000.00" }],
      "transactions": [{ "uuid": "t1", "type": "INTEREST", "origin": 5, "amount": "30.00" }],
      "expected": {
        "accounts": [{ "id": 5, "balance": "1030.00", "pendingExpense": "1030.00", "status": "ACTIVE" }],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "1030.00",
            "destinationBalanceBefore": null,
            "destinationBalanceAfter": null
          }
        ]
      }
    },
    {
      "name": "INTEREST on STORAGE without enough funds",
      "accounts": [{ "id": 1, "type": "STORAGE", "balance": "10.00" }],
      "transactions": [{ "uuid": "t1", "type": "INTEREST", "origin": 1, "amount": "10.01" }],
      "error": { "code": "INSUFFICIENT_FUNDS", "transactionUuid": "t1" }
    },
    {
      "name": "INTEREST does not accept a fee",
      "accounts": [{ "id": 1, "type": "STORAGE", "balance": "100.00" }],
      "transactions": [{ "uuid": "t1", "type": "INTEREST", "origin": 1, "amount": "10.00", "fee": "1.00" }],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "fee", "fieldCode": "FEE_NOT_ALLOWED" }
    },
    {
      "name": "INTEREST does not accept a destination",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "100.00" },
        { "id": 2, "type": "STORAGE", "balance": "100.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "INTEREST", "origin": 1, "destination": 2, "amount": "10.00" }],
