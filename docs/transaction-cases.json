{
  "version": 2,
  "description": "Shared test cases of the transaction engine (backend Java and frontend TypeScript). Amounts are strings with 2 decimals. Defaults: account status ACTIVE, temporary false, creditLimit null; transaction fee 0.00, originApplied true, destinationApplied true, operationDate 2026-10-01T12:00:00, destination null. Each case expects either 'expected' (accounts and transactions to check, matched by id / uuid; transactions listed in application order) or 'error' (first failing transaction; field/fieldCode only for VALIDATION_ERROR). reportedAmount is the full amount for ADDITION / SUBTRACTION and 0 for NEUTER; fees are reported separately by the reports.",
  "cases": [
    {
      "name": "INCOME credits amount minus fee; reported as income for the full amount",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 3, "type": "SUPPLIER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "INCOME", "origin": 3, "destination": 1, "amount": "1000.00", "fee": "50.00" }
      ],
      "expected": {
        "accounts": [{ "id": 1, "balance": "1950.00", "status": "ACTIVE" }],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "ADDITION",
            "reportedAmount": "1000.00",
            "originBalanceBefore": null,
            "originBalanceAfter": null,
            "destinationBalanceBefore": "1000.00",
            "destinationBalanceAfter": "1950.00"
          }
        ]
      }
    },
    {
      "name": "INCOME fee must be lower than the amount",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "0.00" },
        { "id": 3, "type": "SUPPLIER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "INCOME", "origin": 3, "destination": 1, "amount": "100.00", "fee": "100.00" }
      ],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "fee", "fieldCode": "FEE_NOT_BELOW_AMOUNT" }
    },
    {
      "name": "INCOME origin cannot stay unapplied",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "0.00" },
        { "id": 3, "type": "SUPPLIER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "INCOME", "origin": 3, "destination": 1, "amount": "100.00", "originApplied": false }
      ],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "originApplied", "fieldCode": "PENDING_NOT_ALLOWED" }
    },
    {
      "name": "INCOME destination cannot stay unapplied",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "0.00" },
        { "id": 3, "type": "SUPPLIER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "INCOME", "origin": 3, "destination": 1, "amount": "100.00", "destinationApplied": false }
      ],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "destinationApplied", "fieldCode": "PENDING_NOT_ALLOWED" }
    },
    {
      "name": "INCOME origin must be a SUPPLIER",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "100.00" },
        { "id": 2, "type": "STORAGE", "balance": "0.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "INCOME", "origin": 2, "destination": 1, "amount": "10.00" }],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "originAccountId", "fieldCode": "ORIGIN_NOT_ALLOWED" }
    },
    {
      "name": "A GROUP never participates in transactions",
      "accounts": [
        { "id": 3, "type": "SUPPLIER" },
        { "id": 11, "type": "GROUP" }
      ],
      "transactions": [{ "uuid": "t1", "type": "INCOME", "origin": 3, "destination": 11, "amount": "10.00" }],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "destinationAccountId", "fieldCode": "DESTINATION_NOT_ALLOWED" }
    },
    {
      "name": "EXPENSE subtracts amount plus fee from the STORAGE; reported as expense for the amount",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 4, "type": "CONSUMER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "EXPENSE", "origin": 1, "destination": 4, "amount": "200.00", "fee": "10.00" }
      ],
      "expected": {
        "accounts": [{ "id": 1, "balance": "790.00", "status": "ACTIVE" }],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "SUBTRACTION",
            "reportedAmount": "200.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "790.00",
            "destinationBalanceBefore": null,
            "destinationBalanceAfter": null
          }
        ]
      }
    },
    {
      "name": "EXPENSE without enough funds",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "100.00" },
        { "id": 4, "type": "CONSUMER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "EXPENSE", "origin": 1, "destination": 4, "amount": "100.00", "fee": "1.00" }
      ],
      "error": { "code": "INSUFFICIENT_FUNDS", "transactionUuid": "t1" }
    },
    {
      "name": "EXPENSE with the origin unapplied does not touch the balance yet",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 4, "type": "CONSUMER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "EXPENSE", "origin": 1, "destination": 4, "amount": "300.00", "originApplied": false }
      ],
      "expected": {
        "accounts": [{ "id": 1, "balance": "1000.00", "status": "ACTIVE" }],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "SUBTRACTION",
            "reportedAmount": "300.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "1000.00",
            "destinationBalanceBefore": null,
            "destinationBalanceAfter": null
          }
        ]
      }
    },
    {
      "name": "EXPENSE with the origin unapplied is accepted without funds: they are validated when the origin is applied",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "100.00" },
        { "id": 4, "type": "CONSUMER" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "EXPENSE", "origin": 1, "destination": 4, "amount": "500.00", "originApplied": false }
      ],
      "expected": {
        "accounts": [{ "id": 1, "balance": "100.00", "status": "ACTIVE" }],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "SUBTRACTION",
            "reportedAmount": "500.00",
            "originBalanceBefore": "100.00",
            "originBalanceAfter": "100.00",
            "destinationBalanceBefore": null,
            "destinationBalanceAfter": null
          }
        ]
      }
    },
    {
      "name": "EXPENSE cannot come from a DEBTOR (purchases on credit are DEBT to CONSUMER)",
      "accounts": [
        { "id": 5, "type": "DEBTOR", "balance": "0.00", "creditLimit": "5000.00" },
        { "id": 4, "type": "CONSUMER" }
      ],
      "transactions": [{ "uuid": "t1", "type": "EXPENSE", "origin": 5, "destination": 4, "amount": "100.00" }],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "originAccountId", "fieldCode": "ORIGIN_NOT_ALLOWED" }
    },
    {
      "name": "EXPENSE destination must be a CONSUMER",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 2, "type": "STORAGE", "balance": "0.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "EXPENSE", "origin": 1, "destination": 2, "amount": "10.00" }],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "destinationAccountId", "fieldCode": "DESTINATION_NOT_ALLOWED" }
    },
    {
      "name": "TRANSFER subtracts A from the origin and credits A minus fee",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 2, "type": "STORAGE", "balance": "500.00" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "TRANSFER", "origin": 1, "destination": 2, "amount": "300.00", "fee": "5.00" }
      ],
      "expected": {
        "accounts": [
          { "id": 1, "balance": "700.00", "status": "ACTIVE" },
          { "id": 2, "balance": "795.00", "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "700.00",
            "destinationBalanceBefore": "500.00",
            "destinationBalanceAfter": "795.00"
          }
        ]
      }
    },
    {
      "name": "TRANSFER with the destination unapplied: money in transit",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 2, "type": "STORAGE", "balance": "500.00" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "TRANSFER", "origin": 1, "destination": 2, "amount": "300.00", "destinationApplied": false }
      ],
      "expected": {
        "accounts": [
          { "id": 1, "balance": "700.00", "status": "ACTIVE" },
          { "id": 2, "balance": "500.00", "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "700.00",
            "destinationBalanceBefore": "500.00",
            "destinationBalanceAfter": "500.00"
          }
        ]
      }
    },
    {
      "name": "TRANSFER with the origin unapplied: only the destination changes",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 2, "type": "STORAGE", "balance": "500.00" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "TRANSFER", "origin": 1, "destination": 2, "amount": "300.00", "originApplied": false }
      ],
      "expected": {
        "accounts": [
          { "id": 1, "balance": "1000.00", "status": "ACTIVE" },
          { "id": 2, "balance": "800.00", "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "1000.00",
            "destinationBalanceBefore": "500.00",
            "destinationBalanceAfter": "800.00"
          }
        ]
      }
    },
    {
      "name": "TRANSFER with both sides unapplied changes nothing yet",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 2, "type": "STORAGE", "balance": "500.00" }
      ],
      "transactions": [
        {
          "uuid": "t1",
          "type": "TRANSFER",
          "origin": 1,
          "destination": 2,
          "amount": "300.00",
          "originApplied": false,
          "destinationApplied": false
        }
      ],
      "expected": {
        "accounts": [
          { "id": 1, "balance": "1000.00", "status": "ACTIVE" },
          { "id": 2, "balance": "500.00", "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "1000.00",
            "destinationBalanceBefore": "500.00",
            "destinationBalanceAfter": "500.00"
          }
        ]
      }
    },
    {
      "name": "TRANSFER without enough funds",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "100.00" },
        { "id": 2, "type": "STORAGE", "balance": "0.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "TRANSFER", "origin": 1, "destination": 2, "amount": "150.00" }],
      "error": { "code": "INSUFFICIENT_FUNDS", "transactionUuid": "t1" }
    },
    {
      "name": "TRANSFER requires a destination",
      "accounts": [{ "id": 1, "type": "STORAGE", "balance": "100.00" }],
      "transactions": [{ "uuid": "t1", "type": "TRANSFER", "origin": 1, "amount": "10.00" }],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "destinationAccountId", "fieldCode": "DESTINATION_REQUIRED" }
    },
    {
      "name": "Origin and destination must be different",
      "accounts": [{ "id": 1, "type": "STORAGE", "balance": "100.00" }],
      "transactions": [{ "uuid": "t1", "type": "TRANSFER", "origin": 1, "destination": 1, "amount": "10.00" }],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "destinationAccountId", "fieldCode": "SAME_ACCOUNT" }
    },
    {
      "name": "INVEST from STORAGE to INVESTMENT",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 6, "type": "INVESTMENT", "balance": "2000.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "INVEST", "origin": 1, "destination": 6, "amount": "1000.00" }],
      "expected": {
        "accounts": [
          { "id": 1, "balance": "0.00", "status": "ACTIVE" },
          { "id": 6, "balance": "3000.00", "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "0.00",
            "destinationBalanceBefore": "2000.00",
            "destinationBalanceAfter": "3000.00"
          }
        ]
      }
    },
    {
      "name": "INVEST from INVESTMENT to BUSINESS",
      "accounts": [
        { "id": 6, "type": "INVESTMENT", "balance": "2000.00" },
        { "id": 7, "type": "BUSINESS", "balance": "1000.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "INVEST", "origin": 6, "destination": 7, "amount": "500.00" }],
      "expected": {
        "accounts": [
          { "id": 6, "balance": "1500.00", "status": "ACTIVE" },
          { "id": 7, "balance": "1500.00", "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "2000.00",
            "originBalanceAfter": "1500.00",
            "destinationBalanceBefore": "1000.00",
            "destinationBalanceAfter": "1500.00"
          }
        ]
      }
    },
    {
      "name": "INVEST fee must be lower than the amount",
      "accounts": [
        { "id": 1, "type": "STORAGE", "balance": "1000.00" },
        { "id": 6, "type": "INVESTMENT", "balance": "0.00" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "INVEST", "origin": 1, "destination": 6, "amount": "100.00", "fee": "100.00" }
      ],
      "error": { "code": "VALIDATION_ERROR", "transactionUuid": "t1", "field": "fee", "fieldCode": "FEE_NOT_BELOW_AMOUNT" }
    },
    {
      "name": "PROFIT from BUSINESS to STORAGE with fee",
      "accounts": [
        { "id": 7, "type": "BUSINESS", "balance": "1000.00" },
        { "id": 1, "type": "STORAGE", "balance": "1000.00" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "PROFIT", "origin": 7, "destination": 1, "amount": "400.00", "fee": "40.00" }
      ],
      "expected": {
        "accounts": [
          { "id": 7, "balance": "600.00", "status": "ACTIVE" },
          { "id": 1, "balance": "1360.00", "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "1000.00",
            "originBalanceAfter": "600.00",
            "destinationBalanceBefore": "1000.00",
            "destinationBalanceAfter": "1360.00"
          }
        ]
      }
    },
    {
      "name": "PROFIT from a temporary INVESTMENT that leaves balance keeps it ACTIVE",
      "accounts": [
        { "id": 10, "type": "INVESTMENT", "balance": "800.00", "temporary": true },
        { "id": 1, "type": "STORAGE", "balance": "1000.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "PROFIT", "origin": 10, "destination": 1, "amount": "500.00" }],
      "expected": {
        "accounts": [
          { "id": 10, "balance": "300.00", "status": "ACTIVE" },
          { "id": 1, "balance": "1500.00", "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "800.00",
            "originBalanceAfter": "300.00",
            "destinationBalanceBefore": "1000.00",
            "destinationBalanceAfter": "1500.00"
          }
        ]
      }
    },
    {
      "name": "PROFIT that leaves a temporary INVESTMENT at 0 disables it",
      "accounts": [
        { "id": 10, "type": "INVESTMENT", "balance": "800.00", "temporary": true },
        { "id": 1, "type": "STORAGE", "balance": "1000.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "PROFIT", "origin": 10, "destination": 1, "amount": "800.00" }],
      "expected": {
        "accounts": [
          { "id": 10, "balance": "0.00", "status": "DISABLED" },
          { "id": 1, "balance": "1800.00", "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "800.00",
            "originBalanceAfter": "0.00",
            "destinationBalanceBefore": "1000.00",
            "destinationBalanceAfter": "1800.00"
          }
        ]
      }
    },
    {
      "name": "A temporary account disabled by its PROFIT cannot be used later in the same batch",
      "accounts": [
        { "id": 10, "type": "INVESTMENT", "balance": "800.00", "temporary": true },
        { "id": 1, "type": "STORAGE", "balance": "1000.00" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "PROFIT", "origin": 10, "destination": 1, "amount": "800.00", "operationDate": "2026-10-01T12:00:00" },
        { "uuid": "t2", "type": "INVEST", "origin": 1, "destination": 10, "amount": "100.00", "operationDate": "2026-10-02T12:00:00" }
      ],
      "error": { "code": "ACCOUNT_DISABLED", "transactionUuid": "t2" }
    },
    {
      "name": "PROFIT of a temporary account with the origin unapplied does not disable it yet",
      "accounts": [
        { "id": 10, "type": "INVESTMENT", "balance": "800.00", "temporary": true },
        { "id": 1, "type": "STORAGE", "balance": "1000.00" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "PROFIT", "origin": 10, "destination": 1, "amount": "800.00", "originApplied": false }
      ],
      "expected": {
        "accounts": [
          { "id": 10, "balance": "800.00", "status": "ACTIVE" },
          { "id": 1, "balance": "1800.00", "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "800.00",
            "originBalanceAfter": "800.00",
            "destinationBalanceBefore": "1000.00",
            "destinationBalanceAfter": "1800.00"
          }
        ]
      }
    },
    {
      "name": "PROFIT requested but not reflected anywhere yet (withdrawal request): both sides unapplied",
      "accounts": [
        { "id": 6, "type": "INVESTMENT", "balance": "2000.00" },
        { "id": 1, "type": "STORAGE", "balance": "1000.00" }
      ],
      "transactions": [
        {
          "uuid": "t1",
          "type": "PROFIT",
          "origin": 6,
          "destination": 1,
          "amount": "500.00",
          "originApplied": false,
          "destinationApplied": false
        }
      ],
      "expected": {
        "accounts": [
          { "id": 6, "balance": "2000.00", "status": "ACTIVE" },
          { "id": 1, "balance": "1000.00", "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "NEUTER",
            "reportedAmount": "0.00",
            "originBalanceBefore": "2000.00",
            "originBalanceAfter": "2000.00",
            "destinationBalanceBefore": "1000.00",
            "destinationBalanceAfter": "1000.00"
          }
        ]
      }
    },
    {
      "name": "DIVIDEND without destination credits the origin",
      "accounts": [{ "id": 6, "type": "INVESTMENT", "balance": "2000.00" }],
      "transactions": [{ "uuid": "t1", "type": "DIVIDEND", "origin": 6, "amount": "100.00", "fee": "10.00" }],
      "expected": {
        "accounts": [{ "id": 6, "balance": "2090.00", "status": "ACTIVE" }],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "ADDITION",
            "reportedAmount": "100.00",
            "originBalanceBefore": "2000.00",
            "originBalanceAfter": "2090.00",
            "destinationBalanceBefore": null,
            "destinationBalanceAfter": null
          }
        ]
      }
    },
    {
      "name": "DIVIDEND with destination credits the destination only",
      "accounts": [
        { "id": 8, "type": "CREDITOR", "balance": "300.00" },
        { "id": 1, "type": "STORAGE", "balance": "1000.00" }
      ],
      "transactions": [{ "uuid": "t1", "type": "DIVIDEND", "origin": 8, "destination": 1, "amount": "50.00" }],
      "expected": {
        "accounts": [
          { "id": 8, "balance": "300.00", "status": "ACTIVE" },
          { "id": 1, "balance": "1050.00", "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "ADDITION",
            "reportedAmount": "50.00",
            "originBalanceBefore": "300.00",
            "originBalanceAfter": "300.00",
            "destinationBalanceBefore": "1000.00",
            "destinationBalanceAfter": "1050.00"
          }
        ]
      }
    },
    {
      "name": "DIVIDEND with the destination unapplied",
      "accounts": [
        { "id": 6, "type": "INVESTMENT", "balance": "2000.00" },
        { "id": 1, "type": "STORAGE", "balance": "1000.00" }
      ],
      "transactions": [
        { "uuid": "t1", "type": "DIVIDEND", "origin": 6, "destination": 1, "amount": "100.00", "destinationApplied": false }
      ],
      "expected": {
        "accounts": [
          { "id": 6, "balance": "2000.00", "status": "ACTIVE" },
          { "id": 1, "balance": "1000.00", "status": "ACTIVE" }
        ],
        "transactions": [
          {
            "uuid": "t1",
            "operationType": "ADDITION",
            "reportedAmount": "100.00",
            "originBalanceBefore": "2000.00",
